# AEGIS SaaS settings (copy to .env; never commit .env)
AEGIS_SAAS_ENV=dev
AEGIS_SAAS_LOG_LEVEL=INFO
AEGIS_SAAS_DB_SCHEMA=aegis

# Password the migration assigns to the non-superuser runtime role "aegis_app".
# Charset [A-Za-z0-9_-], 24-128 chars.
AEGIS_SAAS_DB_APP_PASSWORD=<generated>

# --- Option A: local docker Postgres (scripts/gen-secrets.py fills these) ---
# AEGIS_SAAS_DB_OWNER_URL_AP_SOUTH=postgresql://postgres:<pw>@127.0.0.1:55432/aegis_ap_south
# AEGIS_SAAS_DB_APP_URL_AP_SOUTH=postgresql://aegis_app:<app-pw>@127.0.0.1:55432/aegis_ap_south

# --- Option B: Supabase (one project per region), SESSION POOLER (IPv4, port 5432) ---
# Owner (migrations only): Supabase "postgres" user via pooler -> user is postgres.<project-ref>
# AEGIS_SAAS_DB_OWNER_URL_AP_SOUTH=postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# App (runtime): custom role via pooler -> user is aegis_app.<project-ref>
# AEGIS_SAAS_DB_APP_URL_AP_SOUTH=postgresql://aegis_app.<ref>:<app-pw>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
AEGIS_SAAS_DB_OWNER_URL_AP_SOUTH=<owner-url>
AEGIS_SAAS_DB_OWNER_URL_EU_WEST=<owner-url>
AEGIS_SAAS_DB_APP_URL_AP_SOUTH=<app-url>
AEGIS_SAAS_DB_APP_URL_EU_WEST=<app-url>

# >= 32 chars random
AEGIS_SAAS_JWT_SIGNING_KEY=<generated>

# Phase 6 - optional LLM explanations (Gemini). Leave empty to disable (deterministic text only).
# Only pseudonymous, allow-listed incident metadata is sent; eu-west tenants are never sent
# (config/aiops.yaml llm.regions_enabled). Never commit a real key.
AEGIS_SAAS_GEMINI_API_KEY=
