# AEGIS collector settings (copy to .env; never commit .env)
AEGIS_COL_COLLECTOR_ID=col_dev_01
AEGIS_COL_REGION=ap-south
AEGIS_COL_HOST=127.0.0.1        # loopback only - enforced
AEGIS_COL_PORT=9100
AEGIS_COL_SAAS_BASE_URL=https://<saas-host>
AEGIS_COL_RAW_RETENTION_HOURS=24
# AEGIS_COL_DB_PATH=<optional absolute path; default apps/collector/data/collector.db>
AEGIS_COL_LOCAL_ADMIN_TOKEN=<generated, >=32 chars>
AEGIS_COL_PSEUDONYM_SECRET=<generated, >=32 chars - never leaves this machine>
# AEGIS_COL_COLLECTOR_TOKEN=<issued by SaaS at registration (Phase 4)>
AEGIS_COL_INGEST_TOKEN=<generated, >=32 chars - required by local sources posting telemetry>
